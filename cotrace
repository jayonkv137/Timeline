#!/usr/bin/env python3
"""COTRACE - Desktop application launcher and developer CLI.

Commands:
  ./cotrace start    Build if stale, seed if empty, start server on 8765, open browser
  ./cotrace dev      Start FastAPI server + Vite dev server with /api proxy
  ./cotrace seed     Seed the local library with reference chats
  ./cotrace --help   Show usage instructions
"""

from __future__ import annotations

import argparse
import os
import signal
import subprocess
import sys
import threading
import time
import webbrowser
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from server.library import Library


def is_dist_stale() -> bool:
    """Return True if dist-workspace is missing or older than workspace sources."""
    dist_html = REPO_ROOT / "web" / "dist-workspace" / "workspace.html"
    if not dist_html.is_file():
        return True

    dist_mtime = dist_html.stat().st_mtime
    src_dir = REPO_ROOT / "web" / "src" / "workspace"
    if not src_dir.is_dir():
        return False

    for path in src_dir.rglob("*"):
        if path.is_file() and path.stat().st_mtime > dist_mtime:
            return True

    cfg_file = REPO_ROOT / "web" / "vite.workspace.config.ts"
    if cfg_file.is_file() and cfg_file.stat().st_mtime > dist_mtime:
        return True

    return False


def build_workspace() -> None:
    """Compile workspace frontend bundle and package into single-file artifact."""
    print("==> Building frontend workspace bundle (dist-workspace)...")
    res = subprocess.run(["npm", "--prefix", "web", "run", "build:workspace"], cwd=REPO_ROOT)
    if res.returncode != 0:
        print("ERROR: Failed to build frontend workspace.", file=sys.stderr)
        sys.exit(res.returncode)


def ensure_library_seeded(lib: Library) -> None:
    """If library contains no active chats, seed it with the 10 reference chats."""
    lib.ensure_layout()
    if len(lib.list_chats()) == 0:
        print(f"==> Library at {lib.root} is empty. Seeding 10 reference chats...")
        from scripts.seed_library import seed_library
        seed_library(library_dir=lib.root)


def cmd_start(args: argparse.Namespace) -> None:
    """Start local application server and open browser."""
    if is_dist_stale():
        build_workspace()

    lib = Library(args.library)
    ensure_library_seeded(lib)

    host = args.host
    port = args.port
    url = f"http://{host}:{port}"

    if not args.no_browser:
        def open_browser() -> None:
            time.sleep(0.6)
            try:
                webbrowser.open(url)
            except Exception:
                pass
        threading.Thread(target=open_browser, daemon=True).start()

    print(f"\n=======================================================")
    print(f" COTRACE Standalone Application")
    print(f" Running at: {url}")
    print(f" Library:    {lib.root}")
    print(f" Press Ctrl+C to stop")
    print(f"=======================================================\n")

    import uvicorn
    from server.app import create_app

    app_instance = create_app(library=lib)
    uvicorn.run(app_instance, host=host, port=port, log_level="info")


def cmd_dev(args: argparse.Namespace) -> None:
    """Start FastAPI server and Vite dev server with proxy for development."""
    lib = Library(args.library)
    ensure_library_seeded(lib)

    server_port = args.port
    vite_port = args.vite_port

    print(f"\n==> Starting backend server on port {server_port}...")
    server_proc = subprocess.Popen(
        [
            sys.executable,
            "-m",
            "uvicorn",
            "server.app:app",
            "--host",
            "127.0.0.1",
            "--port",
            str(server_port),
            "--log-level",
            "warning",
        ],
        cwd=REPO_ROOT,
    )

    print(f"==> Starting Vite dev server on port {vite_port}...")
    vite_url = f"http://localhost:{vite_port}/workspace.html"

    if not args.no_browser:
        def open_browser() -> None:
            time.sleep(1.2)
            try:
                webbrowser.open(vite_url)
            except Exception:
                pass
        threading.Thread(target=open_browser, daemon=True).start()

    try:
        subprocess.run(
            ["npm", "--prefix", "web", "run", "workspace"],
            cwd=REPO_ROOT,
        )
    except KeyboardInterrupt:
        pass
    finally:
        print("\n==> Stopping backend server...")
        server_proc.terminate()
        try:
            server_proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            server_proc.kill()


def cmd_seed(args: argparse.Namespace) -> None:
    """Seed the local library with reference chats."""
    from scripts.seed_library import seed_library
    lib = Library(args.library)
    seeded = seed_library(library_dir=lib.root, clean=args.clean)
    print(f"Successfully seeded {len(seeded)} chats into {lib.root}")


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="./cotrace",
        description="COTRACE Standalone Application Runner",
    )
    subparsers = parser.add_subparsers(dest="command", help="Command to run")

    # start
    p_start = subparsers.add_parser("start", help="Build if stale, start server on 8765, open browser")
    p_start.add_argument("--port", type=int, default=8765, help="Port to listen on (default: 8765)")
    p_start.add_argument("--host", type=str, default="127.0.0.1", help="Host interface (default: 127.0.0.1)")
    p_start.add_argument("--library", type=str, default=None, help="Custom library directory")
    p_start.add_argument("--no-browser", action="store_true", help="Do not automatically open browser")

    # dev
    p_dev = subparsers.add_parser("dev", help="Start FastAPI backend + Vite hot dev server with /api proxy")
    p_dev.add_argument("--port", type=int, default=8765, help="Backend API port (default: 8765)")
    p_dev.add_argument("--vite-port", type=int, default=5173, help="Vite dev server port (default: 5173)")
    p_dev.add_argument("--library", type=str, default=None, help="Custom library directory")
    p_dev.add_argument("--no-browser", action="store_true", help="Do not automatically open browser")

    # seed
    p_seed = subparsers.add_parser("seed", help="Seed local library with 10 reference chats")
    p_seed.add_argument("--library", type=str, default=None, help="Custom library directory")
    p_seed.add_argument("--clean", action="store_true", help="Remove existing chats before seeding")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    if args.command == "start":
        cmd_start(args)
    elif args.command == "dev":
        cmd_dev(args)
    elif args.command == "seed":
        cmd_seed(args)


if __name__ == "__main__":
    main()
