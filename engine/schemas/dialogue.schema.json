{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialogue.schema.json",
  "title": "Dialogue",
  "description": "Array of dialogue turns — one user message + one AI reply = one pair. Architecture §3, row 1.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "pair": {
        "type": "integer",
        "minimum": 1,
        "description": "Pair index (1-based). One pair = one user message + one AI reply."
      },
      "speaker": {
        "type": "string",
        "enum": ["user", "ai"],
        "description": "Who spoke this turn."
      },
      "text": {
        "type": "string",
        "description": "The verbatim turn content."
      },
      "attachments": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "File names or references attached to this turn."
      },
      "ts": {
        "type": "string",
        "description": "ISO 8601 timestamp of the turn."
      }
    },
    "required": ["pair", "speaker", "text", "attachments", "ts"],
    "additionalProperties": false
  }
}
