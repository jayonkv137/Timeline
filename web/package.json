{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "sync-fixture": "node scripts/sync-fixture.js",
    "tokens": "node src/design-system/tokens/build.mjs",
    "tokens:check": "node src/design-system/tokens/build.mjs --check",
    "workspace": "vite --config vite.workspace.config.ts",
    "build:workspace": "tsc -b && vite build --config vite.workspace.config.ts && python3 scripts/package-workspace.py"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
