{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "mockups",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4178", "--directory", "mockups"],
      "port": 4178,
      "url": "http://localhost:4178"
    },
    {
      "name": "workspace",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd web && npx vite --config vite.workspace.config.ts --port 5180 --strictPort"],
      "port": 5180,
      "url": "http://localhost:5180"
    }
  ]
}
